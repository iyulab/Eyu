<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!--
      L1a↔L2 coupling smoke test (Eyu.Formbase only). Consumed as a published package, never a
      ProjectReference — Eyu has no access to formbase's source tree.
    -->
    <PackageVersion Include="Formbase.Core" Version="0.10.1" />
    <!--
      Provenance carrier for routed proposals (ITracedPrediction<T> / PredictionProvenance).
      Contract-only package with zero dependencies; HoneAI.Core and HoneAI.Agents are deliberately
      not referenced — the review gate itself is the consumer's to wire (README, "Confidence routes").
    -->
    <PackageVersion Include="HoneAI.Abstractions" Version="0.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Eyu.Rdf's tests read the exported Turtle back with an independent parser, so the writer is not
      checked against its own idea of the grammar. Test-only: the package writes Turtle itself and
      ships with no RDF dependency. AngleSharp is pinned because dotNetRdf.Core 3.5.2 (the latest)
      resolves a release below the fix for GHSA-pgww-w46g-26qg.
    -->
    <PackageVersion Include="dotNetRdf.Core" Version="3.5.2" />
    <PackageVersion Include="AngleSharp" Version="1.8.2" />
    <!-- Test -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>
