<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!--
      L1a↔L2 coupling smoke test (Eyu.Formbase only). Consumed as a published package, never a
      ProjectReference — Eyu has no access to formbase's source tree.
    -->
    <PackageVersion Include="Formbase.Core" Version="0.9.0" />
    <!--
      Provenance carrier for routed proposals (ITracedPrediction<T> / PredictionProvenance).
      Contract-only package with zero dependencies; HoneAI.Core and HoneAI.Agents are deliberately
      not referenced — the review gate itself is the consumer's to wire (README, "Confidence routes").
    -->
    <PackageVersion Include="HoneAI.Abstractions" Version="0.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>
