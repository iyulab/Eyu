<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Eyu.Rdf</RootNamespace>
    <Description>Writes an Eyu OntologyProposal as an OWL ontology in RDF Turtle -- proposed types as classes, relation names as object properties, entities as named individuals -- with every claim's sources, confidence and basis carried as annotations. No dependency beyond Eyu.Core.</Description>
    <PackageTags>$(PackageTags);rdf;owl;turtle</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Eyu.Core\Eyu.Core.csproj" />
  </ItemGroup>

  <!-- Eyu's name comparison and text forms, compiled here from Eyu.Core's own source rather than made
       public there: one rule for both packages, and no core surface that exists only for this one. -->
  <ItemGroup>
    <Compile Include="..\Eyu.Core\Primitives\TextForm.cs" Link="Shared\TextForm.cs" />
    <Compile Include="..\Eyu.Core\Proposals\VocabularyName.cs" Link="Shared\VocabularyName.cs" />
  </ItemGroup>

</Project>
