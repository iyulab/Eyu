<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Publishes Eyu as a Native AOT executable and runs it. The packages' analyzers (IsAotCompatible)
    catch reflection in Eyu's own code at build time; only a real AOT publish also sees what the
    compiler keeps or drops across the whole graph, dependencies included, and only running the
    result proves the paths that worked under reflection still work without it. Not a test project:
    `dotnet test` does not run it; CI publishes and executes it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    The AOT compiler package comes with the SDK at the runtime patch the SDK was cut with. 10.0.13 carries
    GHSA-p3jp-9v83-76w9 (Brotli decoder out-of-bounds write); raising the pack version here takes the fixed patch
    without waiting for an SDK that bundles it. Drop this once the SDK in use is at 10.0.14 or later.
  -->
  <ItemGroup>
    <KnownILCompilerPack Update="Microsoft.DotNet.ILCompiler" ILCompilerPackVersion="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Eyu.Core\Eyu.Core.csproj" />
    <ProjectReference Include="..\..\src\Eyu.Formbase\Eyu.Formbase.csproj" />
    <ProjectReference Include="..\..\src\Eyu.Rdf\Eyu.Rdf.csproj" />
  </ItemGroup>

</Project>
