<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Eyu.Core.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707;CA1859</NoWarn>
  </PropertyGroup>

  <!--
    Real-model smoke for SinglePassOntologyProposer, mirroring formbase's Live/Llm gate
    (tests/Formbase.Core.Tests/Formbase.Core.Tests.csproj). Needs a reachable
    OpenAI-compatible chat-completions endpoint:
      EYU_LLM_ENDPOINT / EYU_LLM_API_KEY / EYU_LLM_MODEL
      dotnet test -p:IncludeEyuLlmLiveTests=true
    Excluded by default: the suite never depends on an external model and cannot hang. Uses only
    HttpModelClient (BCL HttpClient) — deliberately no model SDK package.
  -->
  <ItemGroup Condition="'$(IncludeEyuLlmLiveTests)' != 'true'">
    <Compile Remove="Live/Llm/**/*.cs" />
  </ItemGroup>

  <!--
    Entity-resolution accuracy on labeled public benchmarks (Benchmark/):
      dotnet test -p:IncludeEyuBenchmarks=true [EYU_BENCHMARK_REPORT=<file>]
    FebrlLinkageMeasurement downloads its (third-party-licensed) data; DeepMatcherLinkageMeasurement reads
    the DeepMatcher benchmarks from EYU_DEEPMATCHER_ROOT and skips without it.
    Excluded by default: they need data from outside the repository and measure rather than gate.
  -->
  <ItemGroup Condition="'$(IncludeEyuBenchmarks)' != 'true'">
    <Compile Remove="Benchmark/**/*.cs" />
  </ItemGroup>

  <!-- The quality measurement reads identity stability through the IRIs Eyu.Rdf writes, not a copy of its rule. -->
  <ItemGroup Condition="'$(IncludeEyuLlmLiveTests)' == 'true'">
    <ProjectReference Include="..\..\src\Eyu.Rdf\Eyu.Rdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Eyu.Core\Eyu.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
